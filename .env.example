# Application
# Set this to the final HTTPS origin in production (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backward-compatible Payload server URL. May match NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-a-long-random-secret

# PostgreSQL (Neon or another managed PostgreSQL provider)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cloudflare R2 / S3-compatible media storage (optional during local development)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Contact delivery (Resend)
RESEND_API_KEY=
# One address or a comma-separated list of recipients.
CONTACT_RECIPIENT_EMAIL=
# Must use a sender on a domain verified in Resend.
CONTACT_FROM_EMAIL="Technical Consulting <contact@your-domain.example>"
