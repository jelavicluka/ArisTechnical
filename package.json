{
  "name": "technical-content-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "legacy:build": "vite build",
    "legacy:dev": "vite --port 5174",
    "legacy:preview": "vite preview --host 127.0.0.1 --port 5174",
    "lint": "oxlint src --deny-warnings",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:categories": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seedCategories.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.2",
    "payload": "3.88.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "oxlint": "1.75.0",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
