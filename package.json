{
  "name": "technical-content-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "oxlint src --deny-warnings",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:categories": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seedCategories.ts",
    "seed:articles": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seedArticles.ts",
    "content:report-walkthrough": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/addReportWalkthrough.ts",
    "content:report-article": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/rewriteReportArticle.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test:search": "node --test tests/articleSearch.test.mjs tests/homeArticleSearch.test.mjs",
    "test:report-journey": "node --test tests/reportJourney.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.2",
    "payload": "3.88.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "^29.1.1",
    "oxlint": "1.75.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
